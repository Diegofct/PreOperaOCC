{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "drizzle",
    // Los scripts corren en Node, no en Hermes. Tienen su propio tsconfig para
    // que los globales de Node (`__dirname`, `Buffer`, los timers) no se
    // filtren al código de la app.
    "scripts",
    "drizzle.config.*.ts"
  ]
}
