# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Variables de entorno (cadena de conexión de la base, secretos de firma).
#
# Se ignora cualquier variante, no solo `.env`: Neon y otros paneles ofrecen
# descargar las credenciales como `env.txt` o `.env.txt`, y esos nombres no los
# cubria ningun patron. Un archivo asi arrastrado a la carpeta del proyecto se
# habria subido al repositorio sin que nada avisara.
.env
.env.*
env.txt
*.env

# La plantilla si se versiona: no lleva valores reales.
!.env.ejemplo
